diff -ruN bots/v213/src/constants.h bots/v218-contract/src/constants.h
--- bots/v213/src/constants.h	2026-11-03 18:34:42.088411000 +0000
+++ bots/v218-contract/src/constants.h	2026-11-03 23:05:54.807631600 +0000
@@ -2031,6 +2031,82 @@
 inline constexpr int CARRIER_SHIFT = 2;
 inline constexpr int CARRIER_MASK = 0x3C;
 
+// v216 (CONTRACT, fight_coord_plan.md F2): one engagement decision per contact, shared by every champion in it.
+//   In v213 the leader writes the fight mode from its own sight (often no enemy at all), and then each champion near an
+//   enemy re-scores alone from its own tile (turn.cpp step 5), so up to five champions decide one contact.
+//   With the contract, the first champion each round that has a near enemy (the settler) scores the contact from its
+//   tile and writes the state; the contact holders acting after it this round follow it without re-scoring.
+// Layout (the plan's byte-6 bits were not used: byte 6 is rewritten whole by write_shared and four claim writers, and
+//   CAPTURE_NEWS stores a slot index there; the plan's alternative overloads the mode bits, which every farmer reads):
+//   - state: byte 1 (target slot) bits 6-7. Slots fit in 6 bits while the route has at most 63 groups (the ping makes
+//     the same assumption); the slot's only writers are write_shared and share_loot, both keep the bits. With more
+//     than 63 groups the contract stays off for the game (contract_bits).
+//   - anchor + age: byte 7, the ping's format (route slot + 1 in bits 0-5, round & 3 in bits 6-7). The contract
+//     absorbs the ping: nobody sends a ping while it is on, and ping_slot (answer_ping, the score's ping bonus) is the
+//     anchor of a fresh ENGAGE or GATHER. v218: only with CONTRACT_PING_ANSWER; otherwise v213's ping rides beside it
+//     (HELP, below).
+// CONTRACT_MODE: 0 off (v213 exactly), 1 written but not acted on (state bits written, byte 7 left to the ping),
+//   2 on.
+inline constexpr int CONTRACT_MODE = 2;
+inline constexpr int C_NONE = 0, C_GATHER = 1, C_ENGAGE = 2, C_DISENGAGE = 3;
+inline constexpr const char* CONTRACT_NAMES[] = {"none", "gather", "engage", "disengage"};
+// A champion's part this turn: no contact (or contract off), the settler, a later holder of the same contact, or a
+// holder of a separate contact (played as v213).
+inline constexpr int CR_NONE = 0, CR_SETTLER = 1, CR_FOLLOW = 2, CR_OWN = 3;
+// Whether byte 1's bits 6-7 hold the contract state (state.cpp; set in setup).
+extern bool contract_bits;
+inline constexpr int CONTRACT_SHIFT = 6, CONTRACT_SLOT_MASK = 0x3F;
+// Rounds a contract stays fresh without a refresh (the ping's PING_FRESH). Byte 7's age holds 0-3.
+inline constexpr int CONTRACT_FRESH = 2;
+// A contact more than CONTRACT_ARRIVE tiles from a contract settled this round is a separate contact: played as v213.
+inline constexpr int CONTRACT_ARRIVE = 12;
+// Back from DISENGAGE to ENGAGE needs the bar + CONTRACT_REENTER (ENGAGE stays at the bar - FIGHT_HYSTERESIS).
+inline constexpr int CONTRACT_REENTER = 5;
+// A later contact holder whose own score is under the stay bar by more than this writes DISENGAGE (0: no veto).
+inline constexpr int CONTRACT_VETO = 0;
+// GATHER (hold out of reach while healthy allies within reach of the anchor come) instead of DISENGAGE.
+inline constexpr bool CONTRACT_GATHER = false;
+// The settler's own emblem gap at OUTCLASS_GAP or worse writes DISENGAGE (OUTCLASS as an input to the settler).
+//   v218: zz-ct-noans-nooc (this off) went 11-13 with 230 deaths vs zz-ct-noans 13-11 / 204 (24 debug games vs v210): on.
+inline constexpr bool CONTRACT_OUTCLASS = true;
+
+// ---- v218 (v216-contract fixes; bots/v218-contract/README.md) ----
+// CONTRACT_PING_ANSWER: whether a fresh ENGAGE / GATHER contract is answered like a ping (v216: true). In 24 debug games
+//   vs v210 (12 maps x 2 sides), v216-contract went 1-23 with 337 champion deaths and 4,020 ping-answer turns, against
+//   v213's 12-12, 218 deaths and 347 answers: every healthy farmer within PING_ARRIVE walked to every contact
+//   (answer_ping in FARM mode, fight()'s no-enemy answer, the leader's +5 PING_SCORE bonus), which is what lost for
+//   PING_GATHER and FIGHT_COMMIT_PING. It also ended PING_RETREAT (0 ping.retreat turns vs 170): nobody pinged, so
+//   ping_mine_round was never set. The probe zz-ct-noans (false, and no ping either) went 13-11 with 204 deaths, banked
+//   equal to v213. False here, and v213's hurt-and-alone ping is back (HELP below).
+inline constexpr bool CONTRACT_PING_ANSWER = false;
+// v218 (HELP): v213's ping under the contract. update_ping sends it on v213's rule (an enemy champion took PING_MIN_LOSS
+//   from us with no ally within PING_ALONE) and sets ping_mine_round (PING_RETREAT); allies answer it as in v213
+//   (answer_ping, the PING_SCORE bonus, PING_COLLECTOR). An ENGAGE alone is never answered.
+// Layout: byte 7 stays the contract's anchor + age (round B of its last write). The ping is a 2-bit age K, "sent K-1
+//   rounds before B" (0: no ping), with K bit 0 in byte 3 bit 6 (HELP_LOW_FLAG) and K bit 1 in byte 4 bit 7
+//   (HELP_HIGH_FLAG). The ping's slot is byte 7's anchor: the pinger writes its own nearest slot there with B = now and
+//   K = 1 (published after contract_turn, so its own settle reads the old contract), and a settler keeps that anchor
+//   while the ping is fresh, re-coding K for its new B (K' = age + K). So the slot answered is the pinger's, as in v213.
+//   Every byte-7 writer re-codes K; update_ping clears K with byte 7, or alone once the ping is PING_FRESH old.
+//   - byte 3 (collector) bit 6: a collector is champion + 1 (at most 14) and CAPTURE_NEWS is CAPTURED_MARK (bit 7) |
+//     round & 0x3F (bits 0-5), so bit 6 was never set. read_shared masks it off; write_shared and the four claim
+//     writers (set_collector_byte) keep it.
+//   - byte 4 (stamp) bit 7: FOCUS is an enemy roster index + 1, at most 6 (five picks, Cassi and Issac two bodies), so
+//     bits 4-6 hold it. read_focus masks bit 7 off; write_focus and write_shared keep it.
+//   Both are live only with help_bits (contract on, CONTRACT_PING_ANSWER off); otherwise nothing changes.
+extern bool help_bits;
+inline constexpr int HELP_LOW_FLAG = 0x40, HELP_HIGH_FLAG = 0x80;
+// v218 (CONTRACT_HOLD): a settler flips ENGAGE <-> DISENGAGE only once the state has held this many rounds (each
+//   champion notes locally the round it saw the contract state change; a settler with no prior state is unaffected).
+//   zz-ct-noans: 652 engage<->disengage flips in 24 games, 205 of them 1-2 rounds after the last (v213's shared mode has
+//   MIN_HOLD 1). The emblem veto (CONTRACT_OUTCLASS) leaves at once unless CONTRACT_HOLD_OUTCLASS.
+inline constexpr int CONTRACT_HOLD = 3;
+inline constexpr bool CONTRACT_HOLD_OUTCLASS = false;
+// v218 (CONTRACT_SKIP_RESCORE): the settler takes the shared mode without scoring where v213 would not rescore: FIGHT ->
+//   ENGAGE unless the contract is DISENGAGE (re-entry needs CONTRACT_REENTER), RETREAT -> DISENGAGE unless it is ENGAGE
+//   (staying needs the score). zz-ct-noans: mean fuel 37.8k vs v213 37.0k, out-of-fuel turns 0.41-0.45% vs 0.32%.
+inline constexpr bool CONTRACT_SKIP_RESCORE = true;
+
 // Items alternate shard, emblem: every odd item index is an emblem, every even one a shard.
 inline constexpr int ITEM_COUNT = static_cast<int>(Item::enum_type::count);
 inline bool is_emblem(int item) { return item % 2 == 1; }
diff -ruN bots/v213/src/contract.cpp bots/v218-contract/src/contract.cpp
--- bots/v213/src/contract.cpp	1970-01-01 00:00:00.000000000 +0000
+++ bots/v218-contract/src/contract.cpp	2026-11-03 23:09:56.154656200 +0000
@@ -0,0 +1,156 @@
+// v216 (CONTRACT): one engagement decision per contact (fight_coord_plan.md F2; constants.h has the layout).
+// v218: the help ping beside it (HELP), CONTRACT_HOLD, CONTRACT_SKIP_RESCORE.
+#include "bot.h"
+#include "seen.h"
+#include "state.h"
+
+void Bot::contract_turn(const bc::champion& me) {
+    contract_role = CR_NONE;
+    contract_state = C_NONE;
+    contract_anchor = -1;
+    if (!contract_bits || route.empty()) return;
+    const int now = static_cast<int>(bc::round_number());
+
+    // The contract as the champions before us left it: fresh while its age is at most CONTRACT_FRESH, settled this
+    // round when written this round (update_ping clears byte 7 past PING_FRESH, so age 0 is never 4 rounds old).
+    // v218: byte 7 as update_ping left it this turn (no second read), and the state only under a fresh anchor.
+    int anchor = -1, age = 4, state = C_NONE;
+    if (CONTRACT_MODE == 2) {
+        const int value = ping_byte_round == now ? ping_byte_seen : shared_byte(PING_BYTE);
+        anchor = (value & 63) - 1;
+        age = (now - (value >> 6)) & 3;
+        if (anchor < 0 || anchor >= static_cast<int>(route.size()) || age > CONTRACT_FRESH) anchor = -1;
+        if (anchor >= 0) state = read_contract_state();
+        // v218 (CONTRACT_HOLD): every champion, every turn, notes when the state it reads changed.
+        see_contract(state, now);
+    }
+    if (!me.is_alive() || channelling(me) || me.is_teleporting()) return;
+    const auto& near = near_enemies();
+    if (near.empty()) return;
+    const auto position = seen::self_position();
+    // v218 (HELP): a fresh help ping owns byte 7's anchor: settlers keep it, and a far contact plays alone.
+    const int k = help_bits && anchor >= 0 && ping_byte_round == now ? help_k_seen : 0;
+    const bool help_up = k > 0;
+    const bool same = anchor >= 0 && distance(position, centers[anchor]) <= CONTRACT_ARRIVE;
+    const bool settled = anchor >= 0 && age == 0;
+    if ((settled || help_up) && !same) {
+        contract_role = CR_OWN;
+        NOTE(format("contract: own contact, %d from the anchor s%d (%s%s): play it alone", distance(position, centers[anchor]),
+                    anchor, CONTRACT_NAMES[state], help_up && !settled ? ", help ping" : ""));
+        return;
+    }
+    if (settled) {
+        contract_role = CR_FOLLOW;
+        contract_state = state;
+        contract_anchor = anchor;
+        // One veto, toward safety only: far under our own stay bar.
+        if (CONTRACT_VETO > 0 && state == C_ENGAGE) {
+            score_mode(position, FIGHT);
+            const double stay = last_base_bar - FIGHT_HYSTERESIS;
+            if (last_score < stay - CONTRACT_VETO) {
+                write_contract_state(C_DISENGAGE);
+                contract_state = C_DISENGAGE;
+                see_contract(C_DISENGAGE, now);
+                NOTE(format("contract: engage -> disengage, veto at %.1f (stay bar %.0f): ", last_score, stay) + score_why);
+            }
+        }
+        return;
+    }
+
+    // We settle this contact. The anchor: the help ping's while it is fresh, else the route slot nearest us.
+    int mine = help_up ? anchor : 0;
+    if (!help_up) {
+        int gap = distance(position, centers[0]);
+        for (int s = 1; s < static_cast<int>(centers.size()); ++s) {
+            const int d = distance(position, centers[s]);
+            if (d < gap) gap = d, mine = s;
+        }
+    }
+    if (mine >= 63) return;
+    // Hysteresis comes from the contract's state, not our own last decision.
+    const int prev = same ? state : C_NONE;
+    int next = C_NONE;
+    std::string why;
+    // v218 (CONTRACT_SKIP_RESCORE): the shared mode stands where v213 would not rescore and the state agrees.
+    if (CONTRACT_SKIP_RESCORE && mode == FIGHT && prev != C_DISENGAGE) {
+        next = C_ENGAGE;
+        LOG(why = "the team's mode is fight";);
+    } else if (CONTRACT_SKIP_RESCORE && mode == RETREAT && prev != C_ENGAGE) {
+        next = C_DISENGAGE;
+        LOG(why = "the team's mode is retreat";);
+    } else {
+        const int choice = score_mode(position, prev == C_ENGAGE ? FIGHT : FARM);
+        bool engage = choice == FIGHT;
+        if (prev == C_DISENGAGE) engage = last_score >= last_base_bar + CONTRACT_REENTER;
+        next = engage ? C_ENGAGE : C_DISENGAGE;
+        LOG(why = score_why;);
+    }
+    // v218 (CONTRACT_HOLD): a flip waits until the state has held CONTRACT_HOLD rounds (as we saw it).
+    const bool holding = (prev == C_ENGAGE || prev == C_DISENGAGE) && now - contract_seen_since < CONTRACT_HOLD;
+    if (holding && (next == C_ENGAGE || next == C_DISENGAGE) && next != prev) {
+        LOG(why = format("held %d of %d rounds; ", now - contract_seen_since, CONTRACT_HOLD) + CONTRACT_NAMES[next] + " wanted: " + why;);
+        NOTE(format("contract: keeps %s at s%d: ", CONTRACT_NAMES[prev], mine) + why);
+        next = prev;
+    }
+    // OUTCLASS as an input: out-emblemed here, the whole contact leaves. v218: not read while a hold would keep ENGAGE
+    // anyway (outclass_gap is shared with this turn's outclass_step).
+    if (next == C_ENGAGE && CONTRACT_OUTCLASS && OUTCLASS && !prism_team() && !win_tribute
+        && !(CONTRACT_HOLD_OUTCLASS && holding && prev == C_ENGAGE)) {
+        bool close = false, finish = false;
+        const int gap = outclass_gap(me, close, finish);
+        if (close && !finish && gap <= OUTCLASS_GAP) {
+            next = C_DISENGAGE;
+            LOG(why = format("out-emblemed by %d; ", -gap) + why;);
+        }
+    }
+    // A chase the team stopped gaining on ends the contract (TEAM_CHASE, from our last update).
+    if (next == C_ENGAGE && team_chase_off()) {
+        next = C_NONE;
+        LOG(why = "chase dropped; " + why;);
+    }
+    write_contract_state(next);
+    if (CONTRACT_MODE == 2) {
+        set_shared_byte(PING_BYTE, (mine + 1) | ((now & 3) << 6));
+        ping_byte_seen = (mine + 1) | ((now & 3) << 6);
+        // v218 (HELP): the ping was sent age + k - 1 rounds ago; from this write (B = now) that is K = age + k.
+        if (help_up) {
+            write_help(age + k);
+            help_k_seen = age + k;
+        }
+        see_contract(next, now);
+    }
+    if (CONTRACT_MODE != 2) {
+        NOTE(format("contract (not acted on): %s at s%d: ", CONTRACT_NAMES[next], mine) + why);
+        return;
+    }
+    contract_role = CR_SETTLER;
+    contract_state = next;
+    contract_anchor = mine;
+    if (next != prev)
+        NOTE(format("contract: %s -> %s at s%d: ", CONTRACT_NAMES[prev], CONTRACT_NAMES[next], mine) + why);
+}
+
+void Bot::publish_help(const bc::champion& me) {
+    // v218 (HELP): update_ping chose to ping (v213's rule); byte 7 takes our slot with B = now and K = 1. A contract
+    // settled this round on our contact keeps its state; any other (stale, unsettled or far) reads NONE this round, so
+    // later contact holders score for themselves as in v213 rather than follow a state nobody settled.
+    const int best = help_publish;
+    help_publish = -1;
+    if (best < 0 || !help_bits || route.empty()) return;
+    const int now = static_cast<int>(bc::round_number());
+    const int value = ping_byte_round == now ? ping_byte_seen : shared_byte(PING_BYTE);
+    const int anchor = (value & 63) - 1;
+    const bool settled = anchor >= 0 && anchor < static_cast<int>(route.size()) && ((now - (value >> 6)) & 3) == 0
+                         && distance(seen::self_position(), centers[anchor]) <= CONTRACT_ARRIVE;
+    if (!settled) {
+        write_contract_state(C_NONE);
+        see_contract(C_NONE, now);
+    }
+    const int byte = (best + 1) | ((now & 3) << 6);
+    set_shared_byte(PING_BYTE, byte);
+    ping_byte_seen = byte;
+    ping_byte_round = now;
+    write_help(1);
+    help_k_seen = 1;
+    (void)me;
+}
