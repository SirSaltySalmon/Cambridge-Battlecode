+    def finish_check(self, me):
+        # Worst case: every camp of the target group in range hits us each round (a camp hits the
+        # nearest champion, so this overcounts). Only basic attacks from allies in reach count as damage.
+        if self.channel_cut:
+            return False, "channel just aborted"
+        if alive(cambc.vision.champions(Team.ENEMY)):
+            return False, "enemy in sight"
+        camps = self.group_camps()
+        if not camps:
+            return False, "no target camps in sight"
+        if all(camp.health() >= camp.max_health() for camp in camps):
+            return False, "target group not started"
+        position = me.position()
+        spawns = self.spawns[self.slot % len(self.route)]
+        for camp in alive(cambc.vision.camps()):
+            if (not spawns.is_set(camp.spawn_position()) and camp.strength() > 0
+                    and camp.health() < camp.max_health()
+                    and distance(position, camp.position()) <= camp.attack_range()):
+                return False, f"other awake camp {at(camp.position())} in range"
+        incoming = sum(camp.strength() for camp in camps
+                       if distance(position, camp.position()) <= camp.attack_range())
+        allies = alive(cambc.vision.champions(Team.ALLY))
+        if me not in allies:
+            allies.append(me)
+        damage = sum(a.strength() for a in allies
+                     if any(distance(a.position(), camp.position()) <= a.attack_range() for camp in camps))
+        if damage <= 0:
+            return False, "nobody in reach to finish"
+        left = sum(camp.health() for camp in camps)
+        kill = -(-left // damage)
+        if incoming <= 0:
+            # Out of camp range means out of our own basic reach too, so we add nothing by staying.
+            return False, "out of camp range"
+        last = me.health() / incoming
+        if kill + FINISH_MARGIN > last:
+            return False, f"kill {kill:.0f}r + {FINISH_MARGIN} > survive {last:.1f}r"
+        return True, f"finish: kill {kill:.0f}r + {FINISH_MARGIN} <= survive {last:.1f}r"
+
     def group_camps(self):
         return self.camps_at(self.slot % len(self.route)) if self.route else []
 
