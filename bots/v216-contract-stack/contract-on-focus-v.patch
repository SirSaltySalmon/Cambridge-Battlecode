     const int target2 = (shared_byte(STAMP_BYTE) & STAMP_MASK) == 0 ? NO_TARGET2 : shared_byte(PHASE_BYTE) & TARGET2_MASK;
     const std::array<std::byte, SHARED_BYTES> data{
-        std::byte(flags & 0xFF), std::byte(slot & 0xFF), std::byte(capture_slot & 0xFF),
+        std::byte(flags & 0xFF), std::byte(slot_byte_of(slot)), std::byte(capture_slot & 0xFF),
         std::byte(collector & 0xFF), std::byte(stamp & 0xFF), std::byte((phase << PHASE_SHIFT | target2) & 0xFF),
         std::byte(claimed & 0xFF)};
     bc::shared_memory.write(0, std::span<const std::byte>{data});
+}
+
+int slot_byte_of(int slot) {
+    if (!contract_bits) return slot & 0xFF;
+    return (slot & CONTRACT_SLOT_MASK) | (shared_byte(SLOT_BYTE) & ~CONTRACT_SLOT_MASK & 0xFF);
+}
+
+int read_contract_state() {
+    return contract_bits ? shared_byte(SLOT_BYTE) >> CONTRACT_SHIFT : C_NONE;
+}
+
+void write_contract_state(int state) {
+    if (!contract_bits) return;
+    set_shared_byte(SLOT_BYTE, (shared_byte(SLOT_BYTE) & CONTRACT_SLOT_MASK) | (state & 3) << CONTRACT_SHIFT);
 }
 
